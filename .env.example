# EasyCake — variables de entorno
#
# Copia este archivo a .env (servidor) o .env.local (desarrollo) y ajusta.
# Ninguno de los dos se sube al repositorio (estan en .gitignore).

# ── Base de datos ────────────────────────────────────────────────────────────
# En el servidor hay UN solo Postgres para todos los proyectos, cada uno con su
# propia base. DB_HOST es el NOMBRE DEL SERVICIO de Postgres en EasyPanel, no
# una IP ni localhost. Lo encuentras en la pestana Credentials/Connection de ese
# servicio (es el mismo valor que ya usan laoficina y qpocoton_pos).
DB_HOST=
DB_USER=postgres
DB_PASSWORD=
DB_NAME=easycake
DB_PORT=5432

# ── Aplicacion ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# true cuando la app se sirve por HTTPS (lo normal en EasyPanel).
# En local, por HTTP plano, dejalo en false: si lo pones en true el navegador
# descarta la cookie de sesion y el login parecera que no funciona.
COOKIE_SECURE=true

# Contrasena del administrador en el PRIMER arranque.
# migrations/003_users.sql siembra el usuario `admin` con una contrasena que
# esta escrita en el repositorio; si defines esta variable, el arranque la
# reemplaza antes de servir. Se aplica solo mientras siga siendo la de fabrica:
# en cuanto la cambies desde /admin, esta variable deja de tener efecto.
ADMIN_PASSWORD=

# ── Solo para docker compose fuera de EasyPanel ─────────────────────────────
# Red externa donde ya vive el Postgres. Tiene que ser una red DEFINIDA POR EL
# USUARIO: en la red `bridge` por defecto Docker no resuelve nombres entre
# contenedores y la conexion falla con ENOTFOUND.
# En EasyPanel esto no aplica: pone los servicios en la misma red por su cuenta.
POSTGRES_NETWORK=
